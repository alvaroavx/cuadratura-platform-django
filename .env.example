DJANGO_SECRET_KEY=change-me-in-local-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=cuadratura
POSTGRES_USER=cuadratura
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
SII_GATEWAY=disabled

# Consulta de contribuyentes por RUT con Tupana (ADR 0007). Deshabilitada si no hay proveedor y API key.
# CONTRIBUTOR_INFO_PROVIDER=tupana
# TUPANA_API_KEY=
# CONTRIBUTOR_INFO_TIMEOUT_SECONDS=8
# CONTRIBUTOR_INFO_RATE_LIMIT_PER_MINUTE=10

# Producción/QA (ver docs/seguridad-produccion.md). En local se dejan comentadas.
# API_REQUIRE_HTTPS=true
# API_REQUIRE_SIGNATURES=true
# API_RATE_LIMIT_PER_MINUTE=60
# API_AUTH_FAILURE_LIMIT=10
# API_AUTH_FAILURE_WINDOW_MINUTES=15
# API_TOKEN_DEFAULT_DAYS=365
# API_TOKEN_ROTATION_GRACE_HOURS=24
# API_CLIENT_IP_HEADER=HTTP_X_REAL_IP
# DJANGO_TRUST_X_FORWARDED_PROTO=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Acceso federado opcional. Usa un cliente OAuth Web propio de Cuadratura.
GOOGLE_AUTH_ENABLED=0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
