server {
    listen 80;
    server_name cuadratura.avx.cl;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt/cuadratura;
        try_files $uri =404;
    }

    location / {
        return 301 https://cuadratura.avx.cl$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name cuadratura.avx.cl;

    ssl_certificate /etc/letsencrypt/live/cuadratura.avx.cl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cuadratura.avx.cl/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 5m;

    location = /admin { return 404; }
    location ^~ /admin/ { return 404; }
    location = /api/v1/organizations { return 404; }
    location ^~ /api/v1/organizations/ { return 404; }

    location = /accounts/google/login/callback/ {
        access_log off;
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
